# ============================================================
#  Trazo — variables de entorno (EJEMPLO)
#  Copia este archivo a `.env` y rellena valores reales.
#  El `.env` real NUNCA se sube al repo (ver .gitignore).
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=trazo
POSTGRES_PASSWORD=cambia_esto_en_local
POSTGRES_DB=trazo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Backend (FastAPI) ----
# Cadena de conexión que usa el backend (async, asyncpg).
# En Docker el host es "db" (nombre del servicio); en local sería "localhost".
DATABASE_URL=postgresql+asyncpg://trazo:cambia_esto_en_local@db:5432/trazo

# Clave para firmar los JWT. En producción: cadena larga y aleatoria.
JWT_SECRET=clave_secreta_solo_para_desarrollo_cambiar
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Orígenes permitidos para el panel web (CORS), separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Al arrancar, ¿sembrar datos de demo (centro, staff, usuarios y ejercicios)?
SEED_ON_STARTUP=true

# Zona horaria de referencia para el motor de alertas.
APP_TIMEZONE=Europe/Madrid
