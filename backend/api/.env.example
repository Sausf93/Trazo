# Backend Trazo — variables locales (si se ejecuta el backend fuera de Docker).
# Para levantar todo con Docker usa el .env de la raíz del repo.

# Entorno: "dev" o "prod".
#  - dev  -> siembra datos de DEMO (cuentas con contraseña conocida) y permite
#            el JWT_SECRET por defecto. SOLO para desarrollo local.
#  - prod -> NO siembra demo y EXIGE un JWT_SECRET propio (si no, no arranca).
# En producción define SIEMPRE ENTORNO=prod.
ENTORNO=dev

DATABASE_URL=postgresql+asyncpg://trazo:cambia_esto_en_local@localhost:5432/trazo
# En prod, genera uno único y largo (p. ej. `openssl rand -hex 32`).
JWT_SECRET=clave_secreta_solo_para_desarrollo_cambiar
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# La siembra de demo solo ocurre si ENTORNO=dev, aunque esto quede en true.
SEED_ON_STARTUP=true
APP_TIMEZONE=Europe/Madrid
